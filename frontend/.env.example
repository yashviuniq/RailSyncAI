# Frontend (Vite) environment configuration.
# Copy relevant values into `.env.development.local` (local) and set in Vercel's
# Environment Variables dashboard for production. Never commit `.env`.

# Full base URL of the deployed backend, including the /api prefix.
# In production (Vercel) set: VITE_API_URL=https://<your-backend>.onrender.com
# If unset, the app falls back to '/api' (works with local dev proxy or a
# server-side rewrite).
VITE_API_URL=railsyncai.onrender.com/api
