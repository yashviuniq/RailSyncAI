# Backend environment configuration.
# Copy this file to `.env` for local development, or set these in Render's
# Environment dashboard for production. Never commit `.env`.

# Port the API listens on. Render injects this automatically.
PORT=8000

# Comma-separated list of allowed browser origins for CORS.
# Use `*` for open access (development only).
# Example: CORS_ORIGINS=https://myapp.vercel.app,http://localhost:5173
CORS_ORIGINS=https://rail-sync-ai.vercel.app/
